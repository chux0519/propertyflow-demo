# Web (Vercel) — safe for the browser
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Importer / workers only (VPS EnvironmentFile, CI secrets) — never in Vercel
# Session pooler (port 5432): the importer relies on advisory locks
DATABASE_URL=

# Image script only (run locally)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
